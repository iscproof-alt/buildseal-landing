{
  "rewrites": [
    {
      "source": "/release/:id",
      "destination": "/verify.html"
    },
    {
      "source": "/seal",
      "destination": "/seal.html"
    },
    {
      "source": "/verify",
      "destination": "/verify.html"
    },
    {
      "source": "/forensic/graph/:id",
      "destination": "/forensic-graph.html"
    },
    {
      "source": "/demo",
      "destination": "/demo.html"
    },
    {
      "source": "/ecosystem",
      "destination": "/ecosystem.html"
    }
  ],
  "functions": {
    "api/seal-decision.js": {
      "maxDuration": 30
    },
    "api/procurement.js": {
      "maxDuration": 60
    }
  }
}
